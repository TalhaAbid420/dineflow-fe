# ============================================================
# Dineflow — environment variables (frontend)
# ============================================================
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only one variable is needed on the Next.js side.

# Server-side base URL the Next.js route handlers use to reach the
# FastAPI backend. NOT exposed to the browser (safe for server-only).
#   Local dev:     http://localhost:8000
#   Production:    https://your-backend-domain
BACKEND_URL=http://localhost:8000
